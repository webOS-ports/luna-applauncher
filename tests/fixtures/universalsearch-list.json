  {
   "id": "com.palm.app.calendar",
   "displayName": "Calendar Events",
   "iconFilePath": "",
   "launchParam": "showEventDetail",
   "launchParamDbField": "_id",
   "dbQuery": {
    "from": "com.palm.calendarevent:1",
    "where": [
     {
      "prop": "searchText",
      "collate": "primary",
      "op": "?",
      "val": ""
     }
    ],
    "desc": false,
    "orderBy": "subject",
    "limit": 20
   },
   "displayFields": [
    "subject",
    {
     "name": "dtstart",
     "type": "timestamp"
    }
   ],
   "batchQuery": false,
   "enabled": true
  },
  {
   "id": "com.palm.app.email",
   "displayName": "Email",
   "iconFilePath": "",
   "launchParam": "emailId",
   "launchParamDbField": "_id",
   "dbQuery": {
    "from": "com.palm.email:1",
    "where": [
     {
      "prop": "flags.visible",
      "op": "=",
      "val": true
     },
     {
      "prop": "searchText",
      "collate": "primary",
      "op": "?",
      "val": ""
     }
    ],
    "desc": true,
    "orderBy": "timestamp",
    "limit": 20
   },
   "displayFields": [
    "from.name",
    "subject"
   ],
   "batchQuery": false,
   "enabled": true
  },
  {
   "id": "org.webosports.app.atlas",
   "displayName": "Bookmarks & History",
   "iconFilePath": "",
   "launchParam": "url",
   "launchParamDbField": "url",
   "dbQuery": [
    {
     "method": "search",
     "params": {
      "query": {
       "from": "com.palm.browserbookmarks:1",
       "where": [
        {
         "prop": "searchText",
         "collate": "primary",
         "op": "?",
         "val": ""
        }
       ],
       "limit": 20
      }
     }
    },
    {
     "method": "search",
     "params": {
      "query": {
       "from": "com.palm.browserhistory:1",
       "where": [
        {
         "prop": "searchText",
         "collate": "primary",
         "op": "?",
         "val": ""
        }
       ],
       "limit": 50
      }
     }
    }
   ],
   "displayFields": [
    "title",
    "url"
   ],
   "batchQuery": true,
   "enabled": true
  }
 ],
